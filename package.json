{
  "name": "sieve-and-scribe",
  "version": "1.0.85",
  "description": "Chat with LLMs on CivitAI to craft image/video generation prompts",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "browser:smoke:setup": "node tools/browser-smoke.mjs setup",
    "browser:smoke:start": "node tools/browser-smoke.mjs start",
    "browser:smoke:install": "node tools/browser-smoke.mjs install",
    "browser:smoke:status": "node tools/browser-smoke.mjs status",
    "browser:smoke:stop": "node tools/browser-smoke.mjs stop",
    "test:assistant:protocol": "vitest run tests/unit/api-client-tool-loop.test.ts",
    "test:assistant:e2e": "pnpm build && playwright test --config playwright.agent.config.ts",
    "test:assistant:live": "node tools/assistant-eval/run.mjs",
    "test:civitai:mcp-contract": "CLLP_RUN_CIVITAI_MCP_CONTRACT=1 vitest run tests/contract/civitai-mcp.contract.test.ts"
  },
  "keywords": [
    "civitai",
    "llm",
    "prompt",
    "chrome-extension"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.0",
    "typescript": "5.7.3",
    "vitest": "^4.1.10",
    "wxt": "^0.20.26"
  },
  "dependencies": {
    "@wxt-dev/storage": "^1.2.8",
    "devalue": "^5.8.2"
  }
}
